# ==========================================
# Telegram API Sozlamalari (my.telegram.org)
# ==========================================
TELEGRAM_API_ID=00000000000000
TELEGRAM_API_HASH=58f......
TELEGRAM_PHONE=+9989000000000

# ==========================================
# Google Sheets Sozlamalari
# ==========================================
# Google Cloud Console orqali olingan Service Account JSON fayl nomi:
GOOGLE_CREDENTIALS_FILE=credentials.json

# Ma'lumotlar saqlanadigan Google Sheet nomi yoki ID'si:
GOOGLE_SHEET_NAME=Leadlar (Userbot)
# Agar ID orqali ulamoqchi bo'lsangiz:
GOOGLE_SHEET_ID=

# ==========================================
# Userbot xulq-atvori va xavfsizlik
# ==========================================
# Kontaktlaringizdagi odamlarga bu savollar berilmasligi uchun True qiling:
IGNORE_CONTACTS=True

# Odamdek 'typing...' ko'rsatib, 1-2 soniya kutib javob yozish (Anti-ban):
SIMULATE_TYPING=True

# ==========================================
# Google Gemini AI Kaliti
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
